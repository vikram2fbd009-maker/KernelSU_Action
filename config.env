# ============================================================ Kernel source ==
# Yahan apka GitHub repo link hai
KERNEL_SOURCE=https://github.com/vikram2fbd009-maker/Kernel_mt6833_bakasu_3.0ghz
KERNEL_SOURCE_BRANCH=main

# Apka device defconfig
KERNEL_CONFIG=camellia_defconfig

# MT6833 ke liye final image name (DTB ke sath)
KERNEL_IMAGE_NAME=Image.gz-dtb
ARCH=arm64

# =============================================================== KernelSU ===
# IMPORTANT: Humne BakaSU (KernelSU) khud integrate kar liya hai.
# Isliye inko 'none' aur 'false' hi rahne dena hai.
KSU_VARIANT=none
KSU_REF=
KSU_HOOK_MODE=manual
KSU_EXPECTED_SIZE=
KSU_EXPECTED_HASH=

# =================================================================== SUSFS ==
# Humne pehle hi susfs.c aur hooks source code mein daal diye hain.
ENABLE_SUSFS=false
SUSFS_REPO=https://gitlab.com/simonpunk/susfs4ksu.git
SUSFS_BRANCH=auto

# ========================================================== Extra patches ===
# path_umount hum khud backport kar chuke hain.
ENABLE_PATH_UMOUNT=false
ENABLE_HIDE_STUFF=false
ENABLE_KPM=false

# ================================================================ Kconfig ===
ADD_KPROBES_CONFIG=false
# OverlayFS 4.14 ke liye zaroori hai
ADD_OVERLAYFS_CONFIG=true
DISABLE_LTO=false
DISABLE_CC_WERROR=false
EXTRA_DEFCONFIG=

# ============================================================= AnyKernel3 ===
USE_CUSTOM_ANYKERNEL3=false
CUSTOM_ANYKERNEL3_SOURCE=
CUSTOM_ANYKERNEL3_BRANCH=

# ============================================================== Packaging ===
NEED_DTBO=false
BUILD_BOOT_IMG=false
SOURCE_BOOT_IMAGE=

# ================================================================= Runner ===
ENABLE_CCACHE=true
REMOVE_UNUSED_PACKAGES=true
