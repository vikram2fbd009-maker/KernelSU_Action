# KernelSU Action -- build profile
# Modified for MT6833 BakaSU Integration

CONFIG_ENV=config.env

# ============================================================ Kernel source ==
# Yahan apka GitHub repo link hai
KERNEL_SOURCE=https://github.com/vikram2fbd009-maker/Kernel_mt6833_bakasu_3.0ghz
KERNEL_SOURCE_BRANCH=main
# Apka device defconfig
KERNEL_CONFIG=camellia_defconfig
# MT6833 ke liye image name (agar pehle Image.gz-dtb tha toh woh rakh sakte hain)
KERNEL_IMAGE_NAME=Image.gz
ARCH=arm64

KERNEL_NAME=
ADD_LOCALVERSION_TO_FILENAME=false

# 4.14 ke liye yeh flags zaroori hain
EXTRA_CMDS:LD=ld.lld KCFLAGS=-Wno-error=strict-prototypes
CUSTOM_CMDS:CLANG_TRIPLE=aarch64-linux-gnu-

# =================================================================== Clang ==
# 4.14 ke liye sabse safe Clang version (r450784e)
CLANG_BRANCH=master-kernel-build-2022
CLANG_VERSION=r450784e

USE_CUSTOM_CLANG=false
CUSTOM_CLANG_SOURCE=
CUSTOM_CLANG_BRANCH=

# 4.14 LLVM mode ko support nahi karta, isliye false hi rahega
USE_LLVM=false

# ===================================================================== GCC ==
ENABLE_GCC_ARM64=true
ENABLE_GCC_ARM32=true
USE_CUSTOM_GCC_64=false
CUSTOM_GCC_64_SOURCE=
CUSTOM_GCC_64_BRANCH=
CUSTOM_GCC_64_BIN=aarch64-linux-android-
USE_CUSTOM_GCC_32=false
CUSTOM_GCC_32_SOURCE=
CUSTOM_GCC_32_BRANCH=
CUSTOM_GCC_32_BIN=arm-linux-androideabi-

# =============================================================== KernelSU ===
# IMPORTANT: Humne BakaSU (KernelSU) khud integrate kar liya hai.
# Isliye inko 'none' aur 'false' hi rahne dena hai, warna script 
# dubara se clone aur patch karegi jisse build fail ho jayega.
KSU_VARIANT=none
KSU_REF=
KSU_HOOK_MODE=manual
KSU_EXPECTED_SIZE=
KSU_EXPECTED_HASH=

# =================================================================== SUSFS ==
# Humne pehle hi susfs.c aur hooks source code mein daal diye hain.
ENABLE_SUSFS=false
SUSFS_REPO=https://gitlab.com/simonpunk/susfs4ksu.git
SUSFS_BRANCH=auto

# ========================================================== Extra patches ===
# path_umount hum khud backport kar chuke hain.
ENABLE_PATH_UMOUNT=false
ENABLE_HIDE_STUFF=false
ENABLE_KPM=false

# ================================================================ Kconfig ===
ADD_KPROBES_CONFIG=false
# OverlayFS 4.14 ke liye zaroori hai
ADD_OVERLAYFS_CONFIG=true
DISABLE_LTO=false
DISABLE_CC_WERROR=false
EXTRA_DEFCONFIG=

# ============================================================= AnyKernel3 ===
USE_CUSTOM_ANYKERNEL3=false
CUSTOM_ANYKERNEL3_SOURCE=
CUSTOM_ANYKERNEL3_BRANCH=

# ============================================================== Packaging ===
NEED_DTBO=false
BUILD_BOOT_IMG=false
SOURCE_BOOT_IMAGE=

# ================================================================= Runner ===
ENABLE_CCACHE=true
REMOVE_UNUSED_PACKAGES=true
